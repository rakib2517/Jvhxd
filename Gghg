<link href="https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;500;600;700&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
:root{--bg:#09101f;--panel:#111b30;--panel2:#182642;--line:#2a3956;--text:#f4f7ff;--muted:#9aabc9;--cyan:#58e0d0;--blue:#6485ff;--purple:#aa7cff;--green:#56d6a0;--gold:#ffd36c;--red:#ff8196}
*{box-sizing:border-box}body{margin:0;background:radial-gradient(circle at 8% 0%,#202e5c 0,transparent 34%),var(--bg);color:var(--text);font-family:'Hind Siliguri',Inter,sans-serif;min-height:100vh}button,input,select,textarea{font:inherit}button{cursor:pointer;border:0}.app{max-width:490px;margin:auto;min-height:100vh;padding:17px 15px 100px}.top{display:flex;align-items:center;justify-content:space-between;margin:4px 0 20px}.brand{display:flex;gap:10px;align-items:center}.logo{width:44px;height:44px;border-radius:15px;background:linear-gradient(135deg,var(--cyan),var(--blue));display:grid;place-items:center;color:#081323;font-size:23px;font-weight:800;box-shadow:0 8px 25px #56e0d033}.brand h1{font-size:19px;margin:0;line-height:1.15}.brand small{color:var(--muted);font-size:10px;letter-spacing:1px}.avatar{border:1px solid var(--line);background:var(--panel);border-radius:13px;padding:10px;color:white}.hero{background:linear-gradient(135deg,#243b70,#49317c 72%,#673b8e);border:1px solid #7784c966;border-radius:24px;padding:21px;position:relative;overflow:hidden}.hero:after{content:"৳";position:absolute;right:14px;top:-22px;font-size:132px;color:#ffffff0d;font-weight:800}.hero-row{display:flex;align-items:center;justify-content:space-between;gap:8px}.eyebrow{font-size:12px;color:#dce5ff}.balance{font:800 34px Inter,sans-serif;letter-spacing:-1px;margin:8px 0}.balance span{font-size:19px}.pill{font-size:10px;border:1px solid #ffffff35;border-radius:99px;padding:5px 9px;color:#e5f9ff;background:#ffffff0b;white-space:nowrap}.hero-actions{display:flex;gap:9px;margin-top:16px}.btn{border-radius:12px;padding:10px 13px;font-weight:700;font-size:12px;transition:.15s}.btn-primary{background:var(--cyan);color:#071521}.btn-ghost{background:#ffffff12;border:1px solid #ffffff2b;color:#fff}.btn-muted{background:var(--panel2);border:1px solid var(--line);color:var(--text)}.btn-danger{background:#ff81961a;border:1px solid #ff819644;color:#ff9aaa}.btn:disabled{opacity:.45;cursor:not-allowed}.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:9px;margin:13px 0 22px}.stat{background:var(--panel);border:1px solid var(--line);border-radius:15px;padding:12px 9px}.stat .ico{font-size:18px}.stat strong{display:block;font:700 17px Inter,sans-serif;margin:6px 0 2px}.stat small{color:var(--muted);font-size:10px}.section-head{display:flex;align-items:center;justify-content:space-between;margin:20px 2px 12px}.section-head h2{font-size:18px;margin:0}.section-head button{background:none;color:var(--cyan);font-size:12px}.task-list{display:grid;gap:10px}.task{display:flex;gap:10px;align-items:center;background:var(--panel);border:1px solid var(--line);border-radius:17px;padding:12px}.task-icon{width:43px;height:43px;flex-shrink:0;border-radius:13px;background:var(--panel2);display:grid;place-items:center;font-size:21px}.task-info{min-width:0;flex:1}.task-info strong{font-size:13px;display:block}.task-info small{display:block;color:var(--muted);font-size:10px;margin-top:3px;line-height:1.4}.tag{display:inline-block;border-radius:7px;background:#56e0d018;color:var(--cyan);font-size:9px;padding:3px 7px;margin-top:5px}.task-side{text-align:right}.reward{font:700 11px Inter,sans-serif;color:var(--green);margin:0 0 6px;white-space:nowrap}.task .btn{padding:7px 9px;font-size:10px;white-space:nowrap}.notice{border:1px solid #ffd36c45;background:#ffd36c0d;color:#ffe6ad;border-radius:13px;padding:11px;font-size:11px;line-height:1.55;margin-top:14px}.panel{display:none}.panel.active{display:block}.nav{position:fixed;bottom:0;left:50%;transform:translateX(-50%);width:min(490px,100%);display:grid;grid-template-columns:repeat(5,1fr);padding:9px 8px calc(9px + env(safe-area-inset-bottom));background:#0d1527ed;backdrop-filter:blur(20px);border-top:1px solid var(--line);z-index:10}.nav button{background:none;color:var(--muted);font-size:9px;padding:5px 0;display:grid;gap:3px;justify-items:center}.nav button span{font-size:18px}.nav button.active{color:var(--cyan)}.card{background:var(--panel);border:1px solid var(--line);border-radius:17px;padding:15px;margin-bottom:11px}.card h3{font-size:15px;margin:0 0 11px}.field{display:grid;gap:6px;margin:10px 0}.field label{font-size:11px;color:var(--muted)}.field input,.field select,.field textarea{width:100%;border:1px solid var(--line);background:#0b1324;color:var(--text);border-radius:11px;padding:10px 11px;outline:none}.field textarea{min-height:70px;resize:vertical}.field input:focus,.field select:focus,.field textarea:focus{border-color:var(--cyan)}.muted{color:var(--muted)}.small-note{font-size:10px;line-height:1.6;color:var(--muted)}.row{display:flex;align-items:center;justify-content:space-between;gap:10px}.divider{height:1px;background:var(--line);margin:12px 0}.empty{padding:22px;text-align:center;color:var(--muted);background:var(--panel);border:1px dashed var(--line);border-radius:15px;font-size:12px}.badge{font-size:9px;color:var(--gold);border:1px solid #ffd36a44;border-radius:7px;padding:4px 7px}.grid2{display:grid;grid-template-columns:1fr 1fr;gap:9px}.mini-stat{padding:11px;background:#0b1324;border:1px solid var(--line);border-radius:12px}.mini-stat strong{display:block;font:700 19px Inter}.toast{position:fixed;top:15px;left:50%;transform:translateX(-50%);z-index:30;background:#202e49;border:1px solid #52668e;color:white;border-radius:12px;padding:10px 14px;max-width:90%;font-size:12px;display:none;box-shadow:0 10px 30px #0005}.toast.show{display:block}.yt{color:#ff929d;background:#ff334b20}.telegram{color:#78c9ff;background:#2585ff20}.quiz{color:#c6a3ff;background:#aa7cff20}.tapbox{background:linear-gradient(145deg,#1b2b4c,#171b3b);border:1px solid #4c5f8c;border-radius:20px;padding:17px;text-align:center}.tap-orb{width:112px;height:112px;border-radius:50%;margin:13px auto;background:radial-gradient(circle at 35% 25%,#83fff0,#44a7ff 50%,#6d52f2 80%);box-shadow:0 0 0 9px #5c8cff12,0 0 35px #57b9ff44;display:grid;place-items:center;color:#091328;font-size:34px;font-weight:800;user-select:none;touch-action:manipulation}.tap-orb:active{transform:scale(.95)}.progress{height:7px;background:#ffffff12;border-radius:99px;overflow:hidden;margin:10px 0}.progress div{height:100%;background:linear-gradient(90deg,var(--cyan),var(--blue));width:0%;transition:width .2s}.video-frame{aspect-ratio:16/9;background:#080d18;border:1px solid var(--line);border-radius:13px;overflow:hidden;display:grid;place-items:center;margin:10px 0;color:var(--muted);font-size:12px}.video-frame iframe{width:100%;height:100%;border:0}.timer{font:800 24px Inter;color:var(--cyan);text-align:center;margin:9px}.history-item{display:flex;justify-content:space-between;gap:10px;padding:10px 0;border-bottom:1px solid var(--line);font-size:11px}.history-item:last-child{border-bottom:0}.method{display:flex;gap:8px;align-items:center;background:#0b1324;border:1px solid var(--line);border-radius:11px;padding:10px;margin:7px 0}.method input{accent-color:var(--cyan)}.subtle-link{color:var(--cyan);word-break:break-all}
</style>
</head>
<body>
<div class="toast" id="toast"></div>
<div class="app">
<header class="top"><div class="brand"><div class="logo">T</div><div><h1>TaskNova</h1><small>TASKS • LEARN • REWARDS</small></div></div><button class="avatar" onclick="showPanel('aboutPanel')">ⓘ</button></header>

<section class="panel active" id="homePanel">
  <div class="hero"><div class="hero-row"><div class="eyebrow">আপনার ডেমো ব্যালেন্স</div><span class="pill">● DEMO MODE</span></div><div class="balance"><span>৳</span><b id="balance">25.00</b></div><div class="hero-row"><span class="eyebrow">টাস্ক সম্পন্ন করে ডেমো রিওয়ার্ড</span><span class="pill">BDT</span></div><div class="hero-actions"><button class="btn btn-primary" onclick="showPanel('tasksPanel')">টাস্ক দেখুন ↗</button><button class="btn btn-ghost" onclick="showPanel('walletPanel')">ওয়ালেট</button></div></div>
  <div class="stats"><div class="stat"><div class="ico">✅</div><strong id="completedStat">0</strong><small>সম্পন্ন টাস্ক</small></div><div class="stat"><div class="ico">🎯</div><strong id="availableStat">5</strong><small>টাস্ক বাকি</small></div><div class="stat"><div class="ico">📅</div><strong id="todayStat">0.00</strong><small>আজকের রিওয়ার্ড</small></div></div>
  <div class="section-head"><h2>✨ দ্রুত শুরু করুন</h2><button onclick="showPanel('tasksPanel')">সব টাস্ক →</button></div><div class="task-list" id="homeTasks"></div>
  <div class="section-head"><h2>👆 Tap Tap</h2><button onclick="showPanel('tapPanel')">খুলুন →</button></div><div class="card"><div class="row"><div><strong>ট্যাপ চ্যালেঞ্জ</strong><div class="small-note">১০ বার ট্যাপ করলে ডেমো বিজ্ঞাপন স্লট দেখাবে</div></div><button class="btn btn-primary" onclick="showPanel('tapPanel')">ট্যাপ করুন</button></div></div>
  <div class="notice">ডেমো সতর্কতা: এখানে দেখানো ব্যালেন্স কাল্পনিক। কোনো প্রকৃত বিজ্ঞাপন, যাচাইকৃত পেমেন্ট বা সার্ভার-সুরক্ষিত রিওয়ার্ড চালু নেই।</div>
</section>

<section class="panel" id="tasksPanel"><div class="section-head"><h2>🎯 টাস্ক সেন্টার</h2><span class="pill">All Tasks</span></div><div class="task-list" id="allTasks"></div><div class="notice">ভিডিও টাস্কে নির্ধারিত সময় চললে ডেমোতে Complete বাটন সক্রিয় হবে। এটি কেবল সময় পার হওয়া যাচাই করে—বাস্তবে ভিডিও দেখেছেন কি না, তা প্রমাণ করে না। YouTube সাবস্ক্রিপশনের বিনিময়ে পুরস্কার দেওয়া হয় না।</div></section>

<section class="panel" id="taskDetailPanel"><div class="section-head"><h2 id="detailTitle">টাস্ক</h2><button onclick="showPanel('tasksPanel')">← ফিরে যান</button></div><div class="card"><div id="detailDescription" class="muted"></div><div id="videoArea"></div><div id="taskActionArea"></div></div></section>

<section class="panel" id="tapPanel"><div class="section-head"><h2>👆 Tap Tap Challenge</h2><span class="pill">10 taps</span></div><div class="tapbox"><div class="muted">প্রতি ট্যাপে অগ্রগতি বাড়বে</div><div class="tap-orb" id="tapButton" role="button" tabindex="0" aria-label="Tap">TAP</div><div style="font:700 19px Inter"><span id="tapCount">0</span> / 10</div><div class="progress"><div id="tapProgress"></div></div><div class="small-note">১০ ট্যাপের পরে শুধু ডেমো ad placeholder দেখানো হবে। Monetag বিজ্ঞাপন স্বয়ংক্রিয়ভাবে লোড করা হয় না।</div></div><div id="tapAdSlot" class="card hidden" style="margin-top:12px"><h3>📣 Gigapub বিজ্ঞাপন</h3><p class="small-note" id="adStatus">১০টি ট্যাপ সম্পন্ন হয়েছে। Gigapub বিজ্ঞাপন চালু করার চেষ্টা করা হচ্ছে…</p><button class="btn btn-primary" id="showAdBtn" onclick="showGigapubAd()">বিজ্ঞাপন দেখুন</button> <button class="btn btn-muted" onclick="resetTaps()">আবার শুরু করুন</button><p class="small-note">বিজ্ঞাপনটি Gigapub SDK ও তাদের উপলব্ধতা/নীতিমালার ওপর নির্ভরশীল। বিজ্ঞাপন না এলে Mini App-টি HTTPS হোস্টিংয়ে চালিয়ে SDK সংযোগ পরীক্ষা করুন।</p></div></section>

<section class="panel" id="walletPanel"><div class="section-head"><h2>👛 ওয়ালেট</h2></div><div class="card"><div class="muted">বর্তমান ডেমো ব্যালেন্স</div><div class="balance"><span>৳</span><b id="walletBalance">25.00</b></div><div class="small-note">বাস্তব অর্থ নয়। উত্তোলনের ফর্মটি শুধু UI ডেমো; কোনো টাকা পাঠানো হবে না।</div></div>
  <div class="card"><h3>উত্তোলনের অনুরোধ (ডেমো)</h3><div class="field"><label>পেমেন্ট মাধ্যম</label><div class="method"><input type="radio" name="method" value="বিকাশ" checked><span>🩷 বিকাশ (bKash)</span></div><div class="method"><input type="radio" name="method" value="নগদ"><span>🟠 নগদ (Nagad)</span></div><div class="method"><input type="radio" name="method" value="রকেট"><span>🟣 রকেট (Rocket)</span></div></div><div class="field"><label>অ্যাকাউন্ট নম্বর (ডেমো)</label><input id="walletNumber" inputmode="numeric" placeholder="01XXXXXXXXX"></div><div class="field"><label>পরিমাণ (৳)</label><input id="withdrawAmount" type="number" min="1" step="1" placeholder="যেমন 100"></div><button class="btn btn-primary" style="width:100%" onclick="requestWithdraw()">অনুরোধ জমা দিন</button><p class="small-note">ব্যক্তিগত পেমেন্ট তথ্য বাস্তব সাইটে দেওয়ার আগে নিশ্চিত হোন যে সাইটটি নিরাপদ। এই ডেমোতে নম্বর সার্ভারে পাঠানো বা সংরক্ষণ করা হয় না।</p></div>
  <div class="card"><h3>লেনদেনের ইতিহাস</h3><div id="history"><div class="empty">এখনো কোনো ডেমো টাস্ক সম্পন্ন হয়নি।</div></div></div></section>

<section class="panel" id="aboutPanel"><div class="section-head"><h2>ℹ️ অ্যাপ সম্পর্কে</h2></div><div class="card"><h3>TaskNova কী?</h3><p class="small-note">TaskNova একটি Telegram Mini App UI ডেমো, যেখানে শেখার টাস্ক, ভিডিও লিংক, কুইজ, ট্যাপ চ্যালেঞ্জ এবং একটি ডেমো ওয়ালেটের ধারণা দেখানো হয়েছে। ব্যবহারকারীরা কাজের তালিকা দেখতে এবং ডেমো অগ্রগতি পরীক্ষা করতে পারবেন।</p><div class="divider"></div><h3>ব্যবহার নীতিমালা</h3><p class="small-note">• ডেমো ব্যালেন্সের কোনো আর্থিক মূল্য নেই।<br>• YouTube সাবস্ক্রিপশন/ভিউ কেনা বা পুরস্কারের বিনিময়ে বাধ্যতামূলক এনগেজমেন্ট বাস্তবায়ন করা হয়নি।<br>• বিজ্ঞাপন প্লেসমেন্ট অবশ্যই বিজ্ঞাপন নেটওয়ার্কের শর্ত মেনে ব্যবহার করতে হবে।<br>• বাস্তব অ্যাপে নিরাপদ ব্যাকএন্ড, Telegram initData যাচাই, ডেটাবেস, অ্যাডমিন অথেনটিকেশন ও পেমেন্ট প্রোভাইডার দরকার।</p></div>
  <div class="card"><h3>প্রোফাইল</h3><div class="row"><span class="muted">Telegram ব্যবহারকারী</span><strong id="userName">Demo User</strong></div><div class="divider"></div><div class="row"><span class="muted">Telegram ID</span><strong id="userId">ডেমো মোড</strong></div></div></section>

<section class="panel" id="adminPanel"><div class="section-head"><h2>⚙️ টাস্ক ম্যানেজমেন্ট</h2><span class="badge">LOCAL DEMO</span></div><div class="notice" style="margin:0 0 12px">ডেমো অ্যাডমিন প্যানেল। এটি পাসওয়ার্ড-সুরক্ষিত নয় এবং যে কেউ ব্যবহার করতে পারে। লাইভ সাইটে ব্যবহার করবেন না। Monetag Zone ID/বিজ্ঞাপন সেটিংস এখানে রাখা হয়নি।</div>
  <div class="card"><h3>➕ নতুন টাস্ক তৈরি করুন</h3><div class="field"><label>টাস্কের নাম</label><input id="newTitle" placeholder="যেমন: নতুন ভিডিও টাস্ক"></div><div class="field"><label>বিবরণ</label><textarea id="newDesc" placeholder="টাস্কের নির্দেশনা"></textarea></div><div class="field"><label>টাস্কের ধরন</label><select id="newType" onchange="toggleTaskFields()"><option value="video">YouTube ভিডিও (সময়ভিত্তিক)</option><option value="telegram">Telegram চ্যানেল/গ্রুপ</option><option value="quiz">কুইজ</option><option value="subscribe">YouTube সাবস্ক্রিপশন (শুধু তথ্য/কোনো রিওয়ার্ড নয়)</option><option value="general">সাধারণ শেখার টাস্ক</option></select></div><div class="field" id="urlField"><label>ভিডিও / চ্যানেল লিংক</label><input id="newUrl" type="url" placeholder="https://www.youtube.com/watch?v=..."></div><div class="field" id="durationField"><label>ভিডিও টাস্কের সময়</label><select id="newDuration"><option value="60">১ মিনিট</option><option value="120">২ মিনিট</option></select></div><div class="field"><label>ডেমো রিওয়ার্ড (৳)</label><input id="newReward" type="number" min="0" max="100" step="0.5" placeholder="2.00"></div><button class="btn btn-primary" onclick="addTask()">টাস্ক যোগ করুন</button><p class="small-note">YouTube সাবস্ক্রিপশন টাস্কে রিওয়ার্ড স্বয়ংক্রিয়ভাবে ৳0 রাখা হয়। টাস্কের URL, সময় ও রিওয়ার্ড শুধু ডেমোতে কাজ করে।</p></div>
